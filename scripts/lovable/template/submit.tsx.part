    try {
      // La función de Supabase guarda el lead y genera el plan con la IA.
      const { data, error: fnError } = await supabase.functions.invoke("quiz-plan", {
        body: { funnel: funnel.slug, answers, contact, tracking: t, website },
      });
      if (fnError) {
        let message = "No hemos podido enviar tus respuestas. Inténtalo de nuevo.";
        try {
          const body = await (fnError as { context?: Response }).context?.json();
          if (body?.error) message = body.error;
        } catch {
          // sin cuerpo legible: mensaje genérico
        }
        setError(message);
        setStep({ kind: "contact" });
        return;
      }
      setStep({ kind: "result", teaser: (data as { teaser?: PlanTeaser | null })?.teaser ?? null });
    } catch {
      setError("Parece que se ha cortado la conexión. Inténtalo de nuevo.");
      setStep({ kind: "contact" });
    }
  }

